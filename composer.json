{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fyuri4/laravel-observability",
    "description": "Production-ready observability for Laravel: traces, spans, slow queries, exceptions.",
    "keywords": [
        "laravel",
        "observability",
        "tracing",
        "monitoring"
    ],
    "homepage": "https://github.com/FYURi4/laravel-observability",
    "license": "MIT",
    "authors": [
        {
            "name": "FURUSHKA",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/routing": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/view": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Furushka\\Observability\\": "src/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test": [
            "@analyse",
            "@lint:check"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Furushka\\Observability\\ObservabilityServiceProvider"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/FYURi4/laravel-observability/issues",
        "source": "https://github.com/FYURi4/laravel-observability"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}